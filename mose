RUN_SBATCH = """#!/bin/bash -l
#SBATCH --partition={part} --nodes=1 --ntasks={n} --cpus-per-task={cpt} --gres=gpu:tesla:{gpus} --mem={mem} --time={time}
#SBATCH --job-name={name} --output={case}/mose_%j.out{nodelist}
# Written by mose {date}: binary {key}
module load nvidia/nvhpc/24.11
MPIRUN={nvhpc}/comm_libs/mpi/bin/mpirun
export OMP_NUM_THREADS=1 NV_ACC_CUDA_HEAPSIZE=512M; ulimit -s unlimited
B={bdir}
cd {case} || exit 1; mkdir -p OUTPUT
[ -x $B/MOSE ] || {{ echo "[mose] no binary in $B: its build failed, see $B/build.log"; exit 1; }}
echo "[mose] binary $B/MOSE  md5 $(md5sum < $B/MOSE | cut -c1-8)  node $(hostname)  $(date)"
echo "[mose] source $(grep -E '^(commits|modified) ' $B/build.info | paste -sd ' ')"
t0=$(date +%s); $MPIRUN -n {n} --bind-to none $B/mose_bind.sh $B/MOSE; rc=$?
echo "[mose] end $(date) rc=$rc wall $(( $(date +%s) - t0 )) s"
exit $rc
"""


def ensure_binary(c, st, args):
    """The binary of this key: already built (no dependency), being built (its job id), or a new build job."""
    key = build_key(c, st)
    bdir = os.path.join(args.builds, key)
    os.makedirs(args.builds, exist_ok=True)
    with open(os.path.join(args.builds, key + '.lock'), 'w') as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)       # one build per key, however many submits run at once
        if os.path.isfile(os.path.join(bdir, 'MOSE')):
            return key, bdir, None
        jf = os.path.join(bdir, 'build.jobid')
        if os.path.isfile(jf):
            with open(jf) as f:
                jid = f.read().strip()
            if jid and job_alive(jid):
                return key, bdir, jid
            log = os.path.join(bdir, 'build.log')
            print('  previous build (job %s) left no binary; its log ends with:' % jid)
            if os.path.isfile(log):
                with open(log, errors='replace') as f:
                    for line in f.read().splitlines()[-8:]:
                        print('    ' + line)
                os.replace(log, log + '.failed-' + jid)
            print('  building again')
        if args.dry_run:
            return key, bdir, 'DRYRUN'
        print('  copying the source for the build (a minute on /scratch) ...', flush=True)
        shutil.rmtree(os.path.join(bdir, 'src'), ignore_errors=True)
        os.makedirs(bdir, exist_ok=True)
        rs = ['rsync', '-a', '--delete'] + ['--exclude=%s' % e for e in SNAPSHOT_EXCLUDES]
        run(rs + [args.src.rstrip('/') + '/', os.path.join(bdir, 'src') + '/'], check=True)
        if source_state(args.src, recipe_for(c))['fp'] != st['fp']:
            shutil.rmtree(os.path.join(bdir, 'src'), ignore_errors=True)
            raise Fail('the source changed while it was being copied: run the command again')
        with open(os.path.join(bdir, 'build.info'), 'w') as f:
            f.write('key %s\nsource %s\ncommits %s\nmodified %s\nrecipe install.sh build %s\nsubmitted %s by %s\n'
                    % (key, os.path.realpath(args.src), ' '.join('%s=%s' % kv for kv in st['heads'].items()),
                       'yes' if st['dirty'] else 'no', ' '.join(recipe_for(c)), time.strftime('%F %T'),
                       os.environ.get('USER', '?')))
        script = os.path.join(bdir, 'build.sbatch')
        with open(script, 'w') as f:
            f.write(BUILD_SBATCH.format(part=args.build_partition, bdir=bdir, key=key, recipe=' '.join(recipe_for(c))))
        jid = sbatch(script)
        with open(jf, 'w') as f:
            f.write(jid + '\n')
        return key, bdir, jid


# ---------------------------------------------------------------------------------------------------- commands
def report(c, st=None, key=None, args=None):
    print('case        %s' % c['case'])
    for k, v in c['notes'].items():
        print('%-11s %s' % (k, v))
    if key:
        built = os.path.isfile(os.path.join(args.builds, key, 'MOSE'))
        print('binary      %s  [%s]' % (key, 'built' if built else 'to build'))
        print('source      %s  (%s%s)' % (os.path.realpath(args.src), ' '.join('%s=%s' % kv for kv in st['heads'].items()),
                                         ', modified' if st['dirty'] else ''))
    for w in c['warnings']:
        print('warning     ' + w)
    for e in c['errors']:
        print('ERROR       ' + e)
    for h in c['hints']:
        print('hint        ' + h)


def no_case(case, depth=2, most=8):
    """The message for a folder without input.ini: the case folders found below it, or how to start one."""
    found, level = [], [case]
    for _ in range(depth):
        below = []
        for d in level:
            try:
                subs = sorted(e.path for e in os.scandir(d) if e.is_dir() and e.name not in ('INPUT', 'MESH', 'OUTPUT'))
            except OSError:
                continue
            found += [os.path.relpath(x, case) for x in subs if os.path.isfile(os.path.join(x, 'input.ini'))]
            below += subs
        level = below
    cmd = next((w for w in sys.argv[1:] if w in ALIASES), 'solve')
    text = 'no input.ini in %s: run mose from a case folder (input.ini + INPUT/), or give the folder' % case
    if found:
        text += '\n  case folders below it:\n' + '\n'.join('    mose %s %s' % (cmd, f) for f in found[:most])
        if len(found) > most:
            text += '\n    ... and %d more' % (len(found) - most)
    else:
        text += ('\n  to start from a test case of MOSE:\n    cp -r %s /scratch/%s/sod && cd /scratch/%s/sod && mose %s .'
                 % (os.path.join(HERE, 'test', '1D', 'Sod79'), os.environ.get('USER', 'user'), os.environ.get('USER', 'user'), cmd))
    return text


def partitions():
    """The SLURM partitions and whether their nodes have GPUs, {name: True/False}; empty when sinfo cannot be asked."""
    exe = shutil.which('sinfo') or os.path.join(SLURM_FALLBACK, 'sinfo')
    try:
        p = subprocess.run([exe, '-h', '-o', '%P %G'], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    parts = OrderedDict()
    for line in (p.stdout.splitlines() if p.returncode == 0 else []):
        w = line.split()
        if w:
            name = w[0].rstrip('*')
            parts[name] = parts.get(name, False) or 'gpu' in ' '.join(w[1:])
    return parts


def prepare(args):
    case = os.path.realpath(args.case)
    c = read_case(case, args.src)
    st = key = None
    if c['nsc'] is not None:
        st = source_state(args.src, recipe_for(c))
        key = build_key(c, st)
    report(c, st, key, args)
    return c, st, key


def cmd_check(args):
    c, _, _ = prepare(args)
    print('-> %s' % ('ready for the GPU: mose solve' if not c['errors'] else '%d error(s): fix them before mose solve' % len(c['errors'])))
    return 1 if c['errors'] else 0


def cmd_build(args):
    c, st, _ = prepare(args)
    if c['errors']:
        print('-> not built: fix the errors above')
        return 1
    key, bdir, jid = ensure_binary(c, st, args)
    if jid is None:
        print('-> binary ready: %s/MOSE' % bdir)
    elif jid == 'DRYRUN':
        print('-> dry run: a build job would make %s/MOSE' % bdir)
    else:
        print('-> build job %s -> %s/MOSE' % (jid, bdir))
    return 0


def cmd_solve(args):
    c, st, _ = prepare(args)
    n = args.ntasks or c['ranks'] or 1
    if c['ranks'] is not None and n != c['ranks']:
        c['errors'].append('-n %d but INPUT/block_owner.txt uses ranks 0..%d: run with -n %d' % (n, c['ranks'] - 1, c['ranks']))
        print('ERROR       ' + c['errors'][-1])
    parts = partitions()
    if parts and not parts.get(args.partition):
        if args.partition in parts:
            why = 'its nodes have no GPU'
        else:
            close = difflib.get_close_matches(args.partition, list(parts), n=2, cutoff=0.5)
            why = 'no such partition' + (' (did you mean %s?)' % ' or '.join(close) if close else '')
        gpus = ', '.join(x for x in parts if parts[x]) or 'none'
        c['errors'].append('-p %s: %s; the partitions with GPUs are %s' % (args.partition, why, gpus))
        print('ERROR       ' + c['errors'][-1])
    if c['errors']:
        print('-> not submitted: fix the errors above')
        return 1
    key, bdir, dep = ensure_binary(c, st, args)
    nodelist = '\n#SBATCH --nodelist=%s' % args.nodelist if args.nodelist else ''
    text = RUN_SBATCH.format(part=args.partition, n=n, cpt=args.cpus_per_task, gpus=args.gpus or n, mem=args.mem,
                             time=args.time, name=args.name or os.path.basename(c['case'])[:24], case=c['case'],
                             nodelist=nodelist, date=time.strftime('%F %T'), key=key, nvhpc=NVHPC, bdir=bdir)
    script = os.path.join(c['case'], 'mose_run.sbatch')
    if args.dry_run:
        print('-> dry run: %s, then the run script below (not written)\n' %
              ('binary ready' if dep is None else 'a build job'))
        print(text)
        return 0
    with open(script, 'w') as f:
        f.write(text)
    jid = sbatch(script, ['--dependency=afterok:%s' % dep] if dep else [])
    if dep:
        print('-> build job %s (binary %s), run job %s starts after it' % (dep, key, jid))
    else:
        print('-> run job %s (binary %s), log %s/mose_%s.out' % (jid, key, c['case'], jid))
    return 0


def cmd_list(args):
    if not os.path.isdir(args.builds):
        print('no builds in %s' % args.builds)
        return 0
    for key in sorted(os.listdir(args.builds)):
        d = os.path.join(args.builds, key)
        if not os.path.isdir(d):
            continue
        state = 'built' if os.path.isfile(os.path.join(d, 'MOSE')) else 'building or failed'
        info = ''
        if os.path.isfile(os.path.join(d, 'build.info')):
            with open(os.path.join(d, 'build.info')) as f:
                info = ' | '.join(l.strip() for l in f if l.startswith(('submitted', 'binary md5', 'modified')))
        print('%-48s %-18s %s' % (key, state, info))
    return 0


def cmd_example(args):
    path = os.path.join(HERE, 'docs', 'user', 'input.gpu.example.ini')
    if not os.path.isfile(path):
        raise Fail('%s not found' % path)
    with open(path) as f:
        sys.stdout.write(f.read())
    return 0


COMMANDS = ('check', 'build', 'solve', 'list', 'example')
ALIASES = COMMANDS + ('submit',)
EXAMPLES = """examples:
  mose check .                     what the case in this folder needs, before the queue
  mose solve .                     build the binary the case needs if it is missing, then run it
  mose solve . -p gpu -n 2         the same on two GPUs of the partition gpu
  mose solve /scratch/$USER/sod    a case given by its folder
The case folder holds input.ini and INPUT/ and is on /scratch. mose -h lists every option."""


class Parser(argparse.ArgumentParser):
    """argparse that answers a wrong or incomplete command with what was probably meant and some examples."""
    commands = {}       # the parser of each command, to answer with its own usage and options

    def error(self, message):
        top = Parser.commands['']
        m = re.search(r"invalid choice: '([^']*)'", message)
        if m:
            here, message = top, 'unknown command %s' % m.group(1)
            tips = difflib.get_close_matches(m.group(1), COMMANDS, n=2, cutoff=0.6)
            known = {o for q in Parser.commands.values() for a in q._actions for o in a.option_strings}
        else:
            here = Parser.commands.get(next((w for w in sys.argv[1:] if w in ALIASES), None), self)
            tips = []
            known = {o for q in (here, top) for a in q._actions for o in a.option_strings}
        for w in sys.argv[1:]:          # every option of the line that is not one of mose
            w = w.split('=')[0]
            if w.startswith('-') and w not in known and not re.match(r'-\d', w):
                tips += [t for t in difflib.get_close_matches(w, sorted(known), n=2, cutoff=0.6) if t not in tips]
        here.print_usage(sys.stderr)
        print('%s: %s' % (here.prog, message), file=sys.stderr)
        if tips:
            print('did you mean: %s' % ', '.join(tips), file=sys.stderr)
        if '-p/--partition' in message:
            parts = partitions()
            if parts:
                print('the partitions with GPUs: %s' % ', '.join(x for x in parts if parts[x]), file=sys.stderr)
        print('\n' + EXAMPLES, file=sys.stderr)
        sys.exit(2)


def main():
    ap = Parser(prog='mose', description=__doc__.split('\n')[0],
                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split('\n', 2)[2])
    ap.add_argument('--src', default=os.environ.get('MOSE_SRC', HERE), help='source tree to build (default: this tree)')
    ap.add_argument('--builds', default=os.environ.get('MOSE_BUILDS', os.path.join('/scratch', os.environ.get('USER', 'user'), 'mose_builds')))
    ap.add_argument('--build-partition', default=os.environ.get('MOSE_BUILD_PARTITION', 'free'))
    sub = ap.add_subparsers(dest='cmd', metavar='{%s}' % ','.join(COMMANDS))
    for name in ('check', 'build', 'solve'):
        p = sub.add_parser(name, aliases=['submit'] if name == 'solve' else [])
        p.add_argument('case', nargs='?', default='.')
        p.add_argument('--dry-run', action='store_true', help='show what would be done, submit nothing')
        if name == 'solve':
            p.add_argument('-n', '--ntasks', type=int, help='MPI ranks (default: the ranks of INPUT/block_owner.txt, else 1)')
            p.add_argument('--gpus', type=int, help='GPUs (default: one per rank)')
            p.add_argument('-p', '--partition', default='fatgpu', help='SLURM partition of the run (default: fatgpu)')
            p.add_argument('-t', '--time', default='02:00:00')
            p.add_argument('-J', '--name')
            p.add_argument('--mem', default='100G')
            p.add_argument('--cpus-per-task', type=int, default=8)
            p.add_argument('--nodelist')
    sub.add_parser('list')
    sub.add_parser('example')
    Parser.commands = dict(sub.choices, **{'': ap})
    args = ap.parse_args()
    args.src = os.path.realpath(args.src)
    try:
        if args.cmd is None:
            ap.print_usage()
            print('\n' + EXAMPLES)
            return 1
        return {'check': cmd_check, 'build': cmd_build, 'solve': cmd_solve, 'submit': cmd_solve,
                'list': cmd_list, 'example': cmd_example}[args.cmd](args)
    except Fail as e:
        print('mose: %s' % e, file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
