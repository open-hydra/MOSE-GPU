def is_open_dialect(secs):
    return 'MOSE-Parameters' in secs or 'MOSE-Numerics' in secs or ini_get(secs, 'MOSE-Physics', 'equations') is not None


class Fail(Exception):
    pass


# ---------------------------------------------------------------------------------------------------- input.ini
def read_ini(path):
    """input.ini as FiNeR reads it: comment lines start with ! ; #, text after ; is an inline comment,
    names are compared exactly (case included). Returns (OrderedDict section -> OrderedDict key -> value,
    list of duplicated 'section' / 'section key' names)."""
    secs, dups, cur = OrderedDict(), [], None
    with open(path, errors='replace') as f:
        for raw in f:
            line = raw.strip()
            if not line or line[0] in '!;#':
                continue
            if line[0] == '[' and ']' in line:
                name = line[1:line.index(']')].strip()
                if name in secs:
                    dups.append('[%s]' % name)
                cur = secs.setdefault(name, OrderedDict())
                continue
            if '=' in line and cur is not None:
                k, v = line.split('=', 1)
                k, v = k.strip(), v.split(';', 1)[0].strip()
                if k in cur:
                    dups.append('%s in its section' % k)
                cur.setdefault(k, v)
    return secs, dups


def ini_get(secs, section, key, default=None):
    return secs.get(section, {}).get(key, default)


def as_logical(v):
    """Fortran list-directed logical: T, .true., true, t... (first letter after the optional dot)."""
    s = v.strip().lstrip('.').lower()
    if s[:1] in ('t', 'f'):
        return s[0] == 't'
    raise ValueError(v)


# ---------------------------------------------------------------------------------------------------- the case
def bc_inflow_records(path):
    """Records of INPUT/bc.txt that the GPU code runs as its inflow/outflow (MOSE_open 401-405 and 407): the header
    lines are six integers (block, i, j, k, face, type); property lines carry reals."""
    n = 0
    with open(path, errors='replace') as f:
        for line in f:
            w = line.split()
            if len(w) == 6 and w[5] in ('401', '402', '403', '404', '405', '407') and all(x.isdigit() for x in w):
                n += 1
    return n


def read_case(case, src):
    """Everything mose needs from the case, plus the errors (stop) and warnings (go on) found on the way."""
    c = {'case': case, 'errors': [], 'warnings': [], 'hints': [], 'notes': OrderedDict()}
    err, warn, note = c['errors'].append, c['warnings'].append, c['notes']
    ini = os.path.join(case, 'input.ini')
    if not os.path.isfile(ini):
        raise Fail(no_case(case))
    secs, dups = read_ini(ini)
    c['secs'] = secs
    for d in dups:
        warn('input.ini repeats %s: write it once (which copy the code takes is not guaranteed)' % d)

    if not os.path.realpath(case).startswith('/scratch/'):
        err('the case is not on /scratch: the GPU nodes run only there')
        c['hints'].append('copy it there: cp -r %s /scratch/%s/%s' % (case, os.environ.get('USER', 'user'), os.path.basename(case)))

    # species: the count FLINT reads from INPUT/phase.txt (Load_ThermoTransport: every line after the first)
    phase = os.path.join(case, 'INPUT', 'phase.txt')
    if os.path.isfile(phase):
        with open(phase, errors='replace') as f:
            c['nsc'] = len(f.read().splitlines()) - 1
        note['species'] = '%d  (INPUT/phase.txt)' % c['nsc']
        if c['nsc'] < 1:
            err('INPUT/phase.txt lists no species')
    else:
        c['nsc'] = None
        err('INPUT/phase.txt missing: the species count comes from it')
    if not os.path.exists(os.path.join(case, 'INPUT', 'bc.txt')):
        err('INPUT/bc.txt missing: the boundary conditions')
    # the features this version does not have (the binary stops on them too: IO_Ini, Stop_On_Removed_Keys)
    for k, what in (('multirate', 'multirate (branch multirate of DIMA-THRUST/MOSE)'),
                    ('j-implicit', 'line-implicit operator (last in 85e3b63 of mose-launcher)'),
                    ('imex', 'IMEX integrator (last in 85e3b63 of mose-launcher)')):
        v = ini_get(secs, 'MOSE-scheme', k)
        if v is not None and v.strip().lower() not in ('f', 'false', '.false.'):
            err('[MOSE-scheme] %s = %s: this version of the code has no %s' % (k, v, what))
    v = ini_get(secs, 'MOSE-scheme', 'solver-type')
    if v is not None and v.strip().lower() != 'explicit':
        err('[MOSE-scheme] solver-type = %s: only explicit in this version (MOSE_open has no implicit solver)' % v)
    # rotating frame: the device inflow has no absolute -> relative conversion of the inlet state (RF_Convert_BC_Inflow)
    rf = (ini_get(secs, 'MOSE-Physics', 'rotational-frame', 'none') or 'none').strip() == 'rigid-body'
    try:
        rf = rf or as_logical(ini_get(secs, 'MOSE-rotating-frame', 'active', 'f'))
    except ValueError:
        pass
    if rf and os.path.exists(os.path.join(case, 'INPUT', 'bc.txt')):
        n = bc_inflow_records(os.path.join(case, 'INPUT', 'bc.txt'))
        if n:
            err('rotating frame with %d inlet/outlet records (MOSE_open 401-405, 407) in INPUT/bc.txt: '
                'the inflow in the rotating frame is not on the GPU' % n)

    # chemistry: finite-rate when INPUT/chemistry-info.txt exists; its first word names the mechanism
    info = os.path.join(case, 'INPUT', 'chemistry-info.txt')
    c['mech'] = None
    opn = is_open_dialect(secs)
    c['open'] = opn
    if opn:
        note['dialect'] = 'MOSE_open (translated by the code at start-up, IO_Ini_Open.f90)'
        chem = ini_get(secs, 'MOSE-Physics', 'chemistry', 'frozen')
        if chem == 'equilibrium':
            err('[MOSE-Physics] chemistry = equilibrium is not on the GPU (frozen or finite-rate)')
        elif chem == 'finite-rate' and not os.path.isfile(info):
            err('[MOSE-Physics] chemistry = finite-rate needs INPUT/chemistry-info.txt')
        elif chem == 'frozen' and os.path.isfile(info):
            note['chemistry'] = 'frozen  ([MOSE-Physics] chemistry = frozen; INPUT/chemistry-info.txt present but not read)'
            info = ''
        elif chem not in ('frozen', 'finite-rate'):
            err('[MOSE-Physics] chemistry = %s: frozen, finite-rate or equilibrium' % chem)
    if os.path.isfile(info):
        with open(info, errors='replace') as f:
            first = f.readline().replace(',', ' ').split()
        c['mech'] = first[0].strip('\'"') if first else ''
        ok = c['mech'] in GPU_MECHANISMS
        note['chemistry'] = '%s  (INPUT/chemistry-info.txt)%s' % (c['mech'], '' if ok else '  NOT ON THE GPU')
        if not ok:
            err('mechanism %r: the GPU integrates only %s' % (c['mech'], ' / '.join(GPU_MECHANISMS)))
    else:
        note['chemistry'] = 'frozen  (no INPUT/chemistry-info.txt)'

    # turbulence: the order of Mod_RANS.f90 (substring tests on the model name), or the MOSE_open keys
    if opn:
        eq = ini_get(secs, 'MOSE-Physics', 'equations', '')
        has_rans = (eq == 'navier-stokes')
        model = (ini_get(secs, 'MOSE-Physics', 'turbulence', 'none') or 'none') if has_rans else 'inviscid'
        if model in ('none', ''):
            model = 'laminar'
        if eq not in ('euler', 'navier-stokes'):
            err('[MOSE-Physics] equations = %s: euler or navier-stokes (required)' % (eq or '(missing)'))
        src_note = '[MOSE-Physics] equations = %s, turbulence' % eq
    else:
        has_rans = any('RANS' in s for s in secs)
        model = ini_get(secs, 'MOSE-RANS', 'turbulence-model', 'laminar') if has_rans else 'inviscid'
        src_note = '[MOSE-RANS] turbulence-model' if has_rans else 'no [MOSE-RANS] section'
    if opn and has_rans and model in GPU_MODELS:
        c['nrans'], kind, gpu = GPU_MODELS[model]
    elif opn and has_rans:
        c['nrans'], kind, gpu = 0, model, False
        err('[MOSE-Physics] turbulence = %s is not on the GPU: use SST, SST-RC, Wilcox2006, SA, SA-R, SA-RC, SAcomp or none' % model)
        gpu = True   # already reported
    elif 'laminar' in model:
        c['nrans'], kind, gpu = 0, 'laminar Navier-Stokes', True
    elif 'SA' in model:
        c['nrans'], kind = 1, 'Spalart-Allmaras'
        gpu = not ('QCR' in model)   # QCR2000: host only
    elif 'Wilcox2006' in model:
        c['nrans'], kind, gpu = 2, 'Wilcox 2006 k-omega', True
    elif 'SST' in model:
        c['nrans'], kind, gpu = 2, 'SST k-omega', True
    elif 'SSGLRR' in model:
        c['nrans'], kind, gpu = 7, 'SSG/LRR-omega', False
    else:
        c['nrans'], kind, gpu = 0, 'Euler (inviscid)', True
        if has_rans and model.lower() not in ('inviscid', 'euler'):
            err('[MOSE-RANS] turbulence-model = %s is not a model name: the code would run inviscid' % model)
    note['turbulence'] = '%s, %d equation(s)  (%s)%s' % (kind, c['nrans'], src_note, '' if gpu else '  NOT ON THE GPU')
    if not gpu and (not opn or model in GPU_MODELS):
        err('%s (%s): the GPU computes SST, SST-RC, Wilcox2006, SA, SA-R, SA-RC and SAcomp only (diff_physics.inc, sst_body.inc, wilcox_body.inc, sa_body.inc); use one of those, laminar or Euler' % (kind, model))

    # chemistry integrator: compile-time on the GPU (radau5_dev or rodas_dev)
    solver = ini_get(secs, 'MOSE-Chemistry', 'ode-solver', 'H-radau5') if opn else ini_get(secs, 'MOSE-ODE', 'solver', 'H-radau5')
    if c['mech']:
        if solver in GPU_ODE:
            c['ode'] = GPU_ODE[solver]
            given = ('MOSE-Chemistry' in secs and 'ode-solver' in secs['MOSE-Chemistry']) if opn else ('MOSE-ODE' in secs and 'solver' in secs['MOSE-ODE'])
            note['integrator'] = '%s  (%s%s)' % (solver, '[MOSE-Chemistry] ode-solver' if opn else '[MOSE-ODE] solver', '' if given else ', default')
        else:
            c['ode'] = 'radau5'
            err('[MOSE-ODE] solver = %s: the GPU integrates the chemistry with %s only' % (solver, ' or '.join(GPU_ODE)))
    else:
        c['ode'] = 'radau5'   # no chemistry: the integrator is not used, share the default binary
        note['integrator'] = 'not used (frozen flow)'

    # convective scheme: Min-Mod + HLLC only (Convective_assert_scheme)
    if opn:
        lim = ini_get(secs, 'MOSE-Numerics', 'flux-limiter', '')
        rs = ini_get(secs, 'MOSE-Numerics', 'riemann-solver', 'HLLC')
        rec = ini_get(secs, 'MOSE-Numerics', 'space-reconstruction', '')
        tsch = ini_get(secs, 'MOSE-Numerics', 'time-scheme', '')
        note['scheme'] = 'time-scheme %s, %s, flux-limiter %s, Riemann %s' % (tsch or '(missing)', rec or '(missing)', lim or '(missing)', rs)
        if rec not in ('MUSCL', 'first-order'):
            err('[MOSE-Numerics] space-reconstruction = %s: MUSCL or first-order' % (rec or '(missing, required)'))
        if rec != 'first-order' and lim.lower() not in ('minmod', 'vanleer', 'vanalbada', 'mc', 'superbee'):
            err('[MOSE-Numerics] flux-limiter = %s: the GPU has minmod, vanleer, vanalbada, mc and superbee' % (lim or '(missing, required)'))
        if rs == 'HLLC-PC' and ini_get(secs, 'MOSE-Numerics', 'integration-variables', 'cons') != 'prec':
            err('[MOSE-Numerics] riemann-solver = HLLC-PC: integration-variables must be set to prec (as MOSE_open)')
        elif rs not in ('HLLC', 'HLLE', 'SLAU', 'AUSM+', 'AUSM+M', 'HLLE++', 'HLLC+Tramel', 'LLF', 'Rusanov', 'SLAU2', 'HLLC+Chen',
                      'exact', 'LMRoe', 'MiczekRoe', 'HLLC-PC'):
            err('[MOSE-Numerics] riemann-solver = %s: riemann-solver must be one of: HLLC, HLLC+Tramel, HLLC+Chen, HLLC-PC, '
                'HLLE, HLLE++, SLAU, SLAU2, LMRoe, MiczekRoe, AUSM+, AUSM+M, LLF, Rusanov, exact (as MOSE_open)' % rs)
        if rs in ('AUSM+M', 'HLLC+Chen', 'LMRoe'):
            try:
                if float(ini_get(secs, 'MOSE-Numerics', 'riemann-options-Mco', '0')) <= 0.0:
                    err('[MOSE-Numerics] riemann-solver = %s needs riemann-options-Mco > 0 (as MOSE_open)' % rs)
            except ValueError:
                err('[MOSE-Numerics] riemann-options-Mco is not a number')
        if tsch not in ('euler', 'RK2', 'RK3'):
            err('[MOSE-Numerics] time-scheme = %s: euler, RK2 or RK3 (required)' % (tsch or '(missing)'))
        sdk = (ini_get(secs, 'MOSE-Numerics', 'shock-detector') or '').lower()
        if sdk not in ('', 'tramel', 'chen'):
            err('[MOSE-Numerics] shock-detector = %s: Tramel or Chen (as MOSE_open)' % sdk)
        iv = ini_get(secs, 'MOSE-Numerics', 'integration-variables', 'cons')
        if iv not in ('cons', 'prim', 'prec'):
            err('[MOSE-Numerics] integration-variables = %s: cons, prim or prec' % iv)
        # irs = true or irs-beta > 0 (MOSE_open: smoothing on) is translated to [MOSE-scheme] IRS/beta: device Mod_IRS_W,
        # one rank (the code stops otherwise)
        try:
            if int(ini_get(secs, 'MOSE-Multigrid', 'levels', '1')) > 1:
                err('[MOSE-Multigrid] levels > 1: multigrid is not on the GPU')
        except ValueError:
            pass
        for k, what in (('soot-generation', 'soot'),):
            v = ini_get(secs, 'MOSE-Physics', k)
            if v is not None and v not in ('none', '0', '0.0', '0.d0', '0d0'):
                err('[MOSE-Physics] %s = %s: %s is not on the GPU' % (k, v, what))
        if ini_get(secs, 'MOSE-Turbulence', 'omega-wall-bc', 'practical') not in ('practical', 'asymptotic'):
            err('[MOSE-Turbulence] omega-wall-bc = %s: practical or asymptotic' % ini_get(secs, 'MOSE-Turbulence', 'omega-wall-bc'))
        if ini_get(secs, 'MOSE-Turbulence', 'sst-production', 'incompressible') not in ('incompressible', 'compressible'):
            err('[MOSE-Turbulence] sst-production = %s: incompressible or compressible' % ini_get(secs, 'MOSE-Turbulence', 'sst-production'))
        try:   # translated into [MOSE-RANS] k-coupling by IO_Ini_Open (k in the total energy): only its form is checked
            as_logical(ini_get(secs, 'MOSE-Turbulence', 'k-energy-coupling', 'false'))
        except ValueError:
            err('[MOSE-Turbulence] k-energy-coupling is not a logical')
        if ini_get(secs, 'MOSE-Numerics', 'cfl') is None:
            err('[MOSE-Numerics] cfl missing: required')
        if ini_get(secs, 'MOSE-Numerics', 'time-accurate') is None:
            err('[MOSE-Numerics] time-accurate missing: required')
        elif iv == 'prec':
            try:
                if as_logical(ini_get(secs, 'MOSE-Numerics', 'time-accurate')):
                    err('[MOSE-Numerics] integration-variables=prec is currently supported only for steady/pseudo-time runs '
                        '(time-accurate = false; as MOSE_open)')
            except ValueError:
                err('[MOSE-Numerics] time-accurate is not a logical')
    else:
        lim = ini_get(secs, 'MOSE-scheme', 'limiter', 'IORD')
        rs = ini_get(secs, 'MOSE-scheme', 'riemann', 'HLLC Batten')
        note['scheme'] = 'limiter %s, Riemann %s' % (lim, rs)
        if lim not in GPU_LIMITERS:
            err('[MOSE-scheme] limiter = %s: the GPU has MINMOD, VANLEER, VANALBADA, MC, SUPERBEE and IORD (first order)' % lim)
        if rs not in GPU_RIEMANN:
            err('[MOSE-scheme] riemann = %s: not a solver of the GPU (those of MOSE_open)' % rs)
        if rs in ('AUSM+M', 'HLLC+Chen', 'LMRoe'):
            try:
                if float(ini_get(secs, 'MOSE-scheme', 'riemann-options-Mco', '0')) <= 0.0:
                    err('[MOSE-scheme] riemann = %s needs riemann-options-Mco > 0 (as MOSE_open)' % rs)
            except ValueError:
                err('[MOSE-scheme] riemann-options-Mco is not a number')
        if ini_get(secs, 'MOSE-parameters', 'cfl') is None and ini_get(secs, 'MOSE-parameters', 'CFL') is None:
            err('[MOSE-parameters] cfl missing: the code stops without it')

    # laminar diffusion: schmidt <= 0 = mixture-averaged multicomponent (DIFF_MC), table needed
    sc = ini_get(secs, 'MOSE-Physics', 'schmidt')
    if sc is None and opn and has_rans and (c['nsc'] or 0) > 1:
        sc = '0.0'   # the MOSE_open default the code applies (IO_Ini_Open.f90)
    if (c['nsc'] or 0) == 1 and sc is None:
        note['diffusion'] = 'single species: no species diffusion'
    elif sc is None:
        note['diffusion'] = 'Schmidt number %s  ([MOSE-RANS] Sc%s; MOSE_open would default to multicomponent)' % (
            ini_get(secs, 'MOSE-RANS', 'Sc', '0.7'), '' if ini_get(secs, 'MOSE-RANS', 'Sc') else ', default')
    else:
        try:
            scv = float(sc.replace('d', 'e').replace('D', 'e'))
        except ValueError:
            scv = None
            err('[MOSE-Physics] schmidt = %s is not a number' % sc)
        if scv is not None and scv <= 0:
            has = any(os.path.exists(os.path.join(case, 'INPUT', 'diffusion' + e)) for e in ('.dat', '.szplt'))
            note['diffusion'] = 'multicomponent (schmidt = %s)%s' % (sc, '' if has else '  TABLE MISSING')
            if not has:
                err('schmidt <= 0 (multicomponent diffusion) needs INPUT/diffusion.dat or .szplt')
        elif scv is not None:
            note['diffusion'] = 'Schmidt number %s' % sc

    # restart: newrun = false reads OUTPUT/field.*
    nr = ini_get(secs, 'MOSE-Parameters', 'newrun') if opn else ini_get(secs, 'MOSE-parameters', 'newrun')
    if nr is None and ini_get(secs, 'MOSE-parameters', 'restart') is not None:
        try:
            nr = 'f' if as_logical(ini_get(secs, 'MOSE-parameters', 'restart')) else 't'
        except ValueError:
            nr = None
    try:
        newrun = True if nr is None else as_logical(nr)
    except ValueError:
        newrun = True
        err('[MOSE-parameters] newrun = %s is not a logical' % nr)
    if newrun:
        # IO_Solution: INPUT/ic.tec (tecplot ascii, default), ic.szplt (tecplot binary), ic.bin (native), ic.vtm (vtk)
        fmt = (ini_get(secs, 'MOSE-IO', 'ic-format' if opn else 'ini-format', 'tecplot ascii') or 'tecplot ascii').split()
        ext = {'native': '.bin', 'vtk': '.vtm'}.get(fmt[0], '.tec' if len(fmt) < 2 or fmt[1] == 'ascii' else '.szplt')
        note['start'] = 'new run from INPUT/ic%s' % ext
        if not os.path.exists(os.path.join(case, 'INPUT', 'ic' + ext)):
            err('INPUT/ic%s missing: the initial field of a new run (%s)' % (ext, ' '.join(fmt)))
    else:
        out = os.path.join(case, 'OUTPUT')
        fields = [f for f in ('field.tec', 'field.szplt', 'field.plt') if os.path.exists(os.path.join(out, f))]
        note['start'] = 'restart from OUTPUT/%s' % (fields[0] if fields else '?')
        if not fields:
            err('newrun = false but no OUTPUT/field.tec or field.szplt to restart from')

    # block -> rank map
    own = os.path.join(case, 'INPUT', 'block_owner.txt')
    c['ranks'] = None
    if os.path.isfile(own):
        try:
            with open(own) as f:
                ranks = [int(x) for x in f.read().split()]
            c['ranks'] = max(ranks) + 1
            note['ranks'] = '%d  (INPUT/block_owner.txt, %d blocks)' % (c['ranks'], len(ranks))
        except ValueError:
            err('INPUT/block_owner.txt is not one integer per block')

    check_keys(secs, src, warn, err)
    return c


OBSOLETE_CALL = re.compile(r"(mr|jimp)_obsolete_keys\s*\(\s*fini\s*,[^\[]*\[character\(len=\d+\)\s*::(.*?)\]"
                           r"\s*(?:,\s*&?\s*repl\s*=\s*'([^']*)')?", re.S)


def known_keys(src):
    """Sections and keys the GPU code reads, and the keys it rejects, taken from the source tree itself (so the
    lists never go stale). Obsolete keys: mr_obsolete_keys with repl= and every jimp_obsolete_keys stop the run."""
    keys, sects, obsolete = set(), set(['MOSE-nochem']), {}
    for top in ('src', os.path.join('lib', 'FLINT', 'src', 'lib')):
        for root, _, files in os.walk(os.path.join(src, top)):
            for fn in files:
                if not fn.lower().endswith(('.f90', '.inc')):
                    continue
                with open(os.path.join(root, fn), errors='replace') as f:
                    s = f.read()
                keys.update(re.findall(r"option_name\s*=\s*'([^']+)'", s))
                sects.update('MOSE' + m for m in re.findall(r"codename\)\s*//\s*'(-[A-Za-z0-9_-]+)'", s))
                for fam, lst, repl in OBSOLETE_CALL.findall(s):
                    if fam == 'jimp':
                        repl = 'omega-source-relax = t | f'
                    for k in re.findall(r"'([^']+)'", lst):
                        obsolete[k] = repl or None
    return sects, keys, obsolete


def check_keys(secs, src, warn, err):
    """Stop on keys the binary rejects; warn on [MOSE-*] sections and keys the GPU code never reads (it would
    silently use its defaults). In the MOSE_open dialect the keys the code translates at start-up are fine."""
    if not os.path.isdir(os.path.join(src, 'src')):
        return
    sects, keys, obsolete = known_keys(src)
    opn = is_open_dialect(secs)
    for sec, opts in secs.items():
        if not sec.startswith('MOSE-'):
            continue   # ATLAS sections (GPB/ICB/BCB/GRIB), probe and material sections
        if opn and sec in OPEN_TRANSLATED:
            for k in opts:
                if k in OPEN_TRANSLATED[sec] or (sec == 'MOSE-IO' and k in keys) or \
                   (sec == 'MOSE-Multigrid' and re.match(r'level\d+-iter$', k)) or \
                   (sec == 'MOSE-Rotating-Frame' and k.startswith('stationary-face-')):
                    continue
                warn('[%s] %s is not read by the GPU code nor translated: the line has no effect' % (sec, k))
            continue
        if opn and sec == 'MOSE-Probes':
            continue
        if sec not in sects:
            hint = OPEN_SECTIONS.get(sec)
            if hint:
                warn('[%s] is not read by the GPU code: use %s' % (sec, hint))
                continue
        for k in opts:
            if k in obsolete and sec == 'MOSE-scheme':
                if obsolete[k]:
                    err('[%s] %s no longer exists and the binary stops on it: use %s' % (sec, k, obsolete[k]))
                else:
                    warn('[%s] %s no longer exists (its production value is built in): delete the line' % (sec, k))
                continue
            if sec == 'MOSE-probes' or (sec in sects and k in keys):
                continue
            hint = OPEN_KEYS.get((sec, k))
            if hint:
                warn('[%s] %s is not read by the GPU code: use %s' % (sec, k, hint))
            else:
                warn('[%s] %s is not read by the GPU code: the line has no effect' % (sec, k))


# ---------------------------------------------------------------------------------------------------- the source
def run(cmd, cwd=None, check=False):
    p = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check and p.returncode != 0:
        raise Fail('%s failed: %s' % (' '.join(cmd), p.stderr.decode(errors='replace').strip()))
    return p.returncode, p.stdout


def own_repo(path):
    rc, out = run(['git', '-C', path, 'rev-parse', '--show-toplevel'])
    return rc == 0 and os.path.realpath(out.decode().strip()) == os.path.realpath(path)


def file_md5(path):
    h = hashlib.md5()
    with open(path, 'rb') as f:
        for blk in iter(lambda: f.read(1 << 20), b''):
            h.update(blk)
    return h.hexdigest()


def entry_digest(path):
    """A symlink by its target (rsync -a copies it as a link), a file by its content, a folder by its entries."""
    if os.path.islink(path):
        return 'L' + os.readlink(path)
    if os.path.isfile(path):
        return 'F' + file_md5(path)
    h = hashlib.md5()
    for root, dirs, files in os.walk(path):
        keep = []
        for d in sorted(dirs):
            if d == '.git' or d.startswith('build'):
                continue
            if os.path.islink(os.path.join(root, d)):
                files.append(d)          # a linked folder counts by its target, like a linked file
            else:
                keep.append(d)
        dirs[:] = keep
        for fn in sorted(files):
            p = os.path.join(root, fn)
            h.update(os.path.relpath(p, path).encode() + entry_digest(p).encode())
    return 'D' + h.hexdigest()


def source_state(src, recipe):
    """Fingerprint of everything the build compiles: per git tree its HEAD, its diff and its untracked files;
    for a populated folder that is not a git tree of its own (OSlo), the content of its files."""
    h, dirty, heads = hashlib.md5(), False, OrderedDict()
    h.update(' '.join(recipe).encode() + NVHPC.encode())
    for sub in ('.',) + SUBTREES:
        path = os.path.normpath(os.path.join(src, sub))
        if sub != '.' and (not os.path.isdir(path) or not os.listdir(path)):
            raise Fail('%s is not checked out in %s (git submodule update --init, or point MOSE_SRC at a full tree)' % (sub, src))
        h.update(sub.encode())
        if own_repo(path):
            _, head = run(['git', '-C', path, 'rev-parse', 'HEAD'], check=True)
            paths = list(BUILD_PATHS) if sub == '.' else ['.']
            _, diff = run(['git', '-C', path, 'diff', 'HEAD', '--binary', '--'] + paths, check=True)
            _, unt = run(['git', '-C', path, 'ls-files', '--others', '--exclude-standard', '-z', '--'] + paths, check=True)
            h.update(head + diff)
            for u in sorted(x for x in unt.decode().split('\0') if x):
                h.update(u.encode() + entry_digest(os.path.join(path, u.rstrip('/'))).encode())
            dirty = dirty or bool(diff.strip() or unt.strip())
            heads[sub] = head.decode().strip()[:7]
        else:
            h.update(entry_digest(path).encode())
            heads[sub] = 'files'
    return {'fp': h.hexdigest()[:8], 'dirty': dirty, 'heads': heads}


def recipe_for(c):
    r = RECIPE + ['--nsc=%d' % c['nsc'], '--nrans=%d' % c['nrans']]
    return r + (['--ode-rodas'] if c['ode'] == 'rodas' else [])


def build_key(c, st):
    return 'nsc%d-nrans%d-%s-%s-%s' % (c['nsc'], c['nrans'], c['ode'], st['heads']['.'], st['fp'])


# ---------------------------------------------------------------------------------------------------- slurm
def slurm(cmd):
    exe = shutil.which(cmd) or os.path.join(SLURM_FALLBACK, cmd)
    if not os.path.isfile(exe):
        raise Fail('%s not found (load the slurm module)' % cmd)
    return exe


def sbatch(script, extra=()):
    p = subprocess.run([slurm('sbatch'), '--parsable'] + list(extra) + [script],
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
    if p.returncode != 0:
        raise Fail('sbatch %s: %s' % (script, p.stderr.strip()))
    return p.stdout.strip().split(';')[0]


def job_alive(jid):
    p = subprocess.run([slurm('squeue'), '-h', '-j', jid, '-o', '%T'],
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
    return p.returncode == 0 and p.stdout.strip() != ''


BUILD_SBATCH = """#!/bin/bash -l
#SBATCH --partition={part} --nodes=1 --ntasks=1 --cpus-per-task=12 --mem=48G --time=01:30:00
#SBATCH --job-name=mose_build --output={bdir}/build.log
# Written by mose: the certified GPU recipe for {key}, built in a private copy of the source taken at submit time.
module purge   # a clean environment: another MPI loaded by the login shell would be found by the TecIO configure
module load nvidia/nvhpc/24.11; module load nvidia/cuda-12.6.2 > /dev/null 2>&1
export GIT_CEILING_DIRECTORIES={bdir}   # the copy has no .git: install.sh's git calls must not climb out of it
cd {bdir}/src || exit 1
t0=$(date +%s)
./install.sh build {recipe} --build-dir={bdir}/src/build --jobs=12 || {{ echo MOSE_BUILD_FAILED; exit 1; }}
[ -x bin/MOSE ] || {{ echo "MOSE_BUILD_FAILED: no bin/MOSE"; exit 1; }}
echo "build wall $(( $(date +%s) - t0 )) s"
grep -E '^(MOSE_NSC|MOSE_NRANS|MOSE_ODE_RODAS|OPENACC_GPU_OPTS|CMAKE_Fortran_FLAGS):' build/CMakeCache.txt | tee -a ../build.info
cp mose_bind.sh ../mose_bind.sh && chmod 555 ../mose_bind.sh
